# TrustLayer example configuration
# Copy to .env and adjust as needed. Do not commit a real .env (it is gitignored).
# All values below are optional; the defaults shown are used when a variable is unset.

# HTTP port TrustLayer listens on.
PORT=3000

# Upstream OpenAI-compatible base URL. TrustLayer always appends
# /v1/chat/completions to the host. Point this at a local gateway
# (Ollama, LiteLLM, vLLM) or a remote provider.
# OPENAI_BASE is accepted as an alias for TARGET_API.
TARGET_API=https://api.openai.com

# Maximum temperature allowed through to the upstream model.
# Higher requested values are capped to this number.
TRUSTLAYER_MAX_TEMPERATURE=0.85

# Safety policy toggles. Each defaults to enabled; set to "false" to disable.
TRUSTLAYER_REDACT_PII=true
TRUSTLAYER_BLOCK_TOPICS=true
TRUSTLAYER_DETECT_JAILBREAK=true

# When "true", the audit log stores the raw extracted input text.
# Leave as "false" to keep only a SHA-256 hash of the input.
TRUSTLAYER_STORE_RAW_TEXT=false

# Directory for JSONL audit logs (created if missing).
TRUSTLAYER_LOG_DIR=./data

# Maximum accepted JSON request body size.
TRUSTLAYER_JSON_LIMIT=2mb
